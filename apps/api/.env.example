DATABASE_URL=postgresql://grill:grill@localhost:5440/darkgrill
REDIS_URL=redis://localhost:6390
PORT=4000
# comma-separated when the web app has more than one URL; the first is used in links
WEB_ORIGIN=http://localhost:3000
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
PAYMENT_WEBHOOK_SECRET=change-me-webhook-secret
# PromptPay receiver (phone or national id) used to build the EMVCo QR payload
PROMPTPAY_ID=0812345678
# Dev mode returns OTP codes in the API response and enables /dev/* simulators
DEV_MODE=true
# Optional LINE integration
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# Optional: shared with apps/web so server-rendered calls skip the per-IP rate limit
INTERNAL_API_KEY=
# Optional: S3-compatible bucket (Cloudflare R2) for uploads; empty = local ./uploads
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
