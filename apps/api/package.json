{
  "name": "api",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "prisma:migrate": "prisma migrate dev",
    "prisma:generate": "prisma generate",
    "seed": "ts-node --transpile-only prisma/seed.ts",
    "test": "node --require ts-node/register/transpile-only --test test/unit.test.ts",
    "test:e2e": "node test/e2e.mjs",
    "prisma:deploy": "prisma migrate deploy",
    "lint": "tsc --noEmit && tsc --noEmit -p cloudflare",
    "cf:deploy": "wrangler deploy",
    "cf:secrets": "wrangler secret bulk .env.cloudflare"
  },
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@nestjs/bullmq": "^11.0.5",
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/platform-socket.io": "^11.2.8",
    "@nestjs/websockets": "^11.2.8",
    "@prisma/client": "^6.19.3",
    "@socket.io/redis-adapter": "^8.3.0",
    "bullmq": "^6.4.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.9",
    "ioredis": "^6.0.0",
    "prisma": "^6.19.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/containers": "^0.3.7",
    "@cloudflare/workers-types": "^5.20261025.1",
    "@nestjs/cli": "^11.0.24",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "wrangler": "^4.152.0"
  }
}
