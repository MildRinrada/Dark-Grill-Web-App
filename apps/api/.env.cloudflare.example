# Secrets for the darkgrill-api worker. Copy to .env.cloudflare (git-ignored), fill in, then:
#   npm run -w apps/api cf:secrets
# Neon: use the direct (non-pooled) connection string; the API is one long-lived process
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/darkgrill?sslmode=require
# Upstash: the TCP endpoint, rediss:// (TLS)
REDIS_URL=rediss://default:PASSWORD@xxxx.upstash.io:6379
# long random strings, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
JWT_SECRET=
JWT_REFRESH_SECRET=
PAYMENT_WEBHOOK_SECRET=
# R2 > Manage API tokens (Object Read & Write on the uploads bucket)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
